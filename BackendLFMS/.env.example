# ============================================================
# Environment Variables - LFMS Backend (Supabase PostgreSQL)
# Copy this file to .env and configure with your Supabase credentials
# ============================================================

# Database (Supabase PostgreSQL)
# Cari di Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI / JDBC

# Opsi 1: Connection Pooling (Port 6543 / 5432) - Disarankan untuk produksi & serverless
# Format: jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]

# Opsi 2: Direct Connection (Port 5432) - Cocok untuk koneksi langsung
# Format: jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres

DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# JWT Security
# Generate random 256-bit base64 key
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# Akun Default Administrator (akan otomatis dibuat saat pertama kali booting)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@example

# Direktori Penyimpanan Unggahan Berkas (Local fallback)
UPLOAD_DIR=uploads

# Supabase Storage Bucket (Penyimpanan Gambar di Cloud)
# Dapatkan di Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_STORAGE_BUCKET=reports

# CORS (Izinkan akses frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
